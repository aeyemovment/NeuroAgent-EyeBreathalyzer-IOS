analysis_csvs/*/data/sessions/
analysis_csvs/*/results/_csv_cache/

# Model artifacts: force-track production model outputs (.cbm, .npy, .json)
# These are NOT regenerable without re-running expensive pipelines
!analysis_csvs/*/data/best_model/
!analysis_csvs/*/data/best_model/**
!analysis_csvs/*/data/artifacts/
!analysis_csvs/*/data/artifacts/**
!analysis_csvs/*/data/per_subject_summary.json
!analysis_csvs/*/data/generalization_results.csv

