{
  "name": "neuroagent-eyebreathalyzer-ios",
  "version": "1.1.0",
  "description": "NeuroAgent EyeBreathalyzer — HazyEyesIOS OKN/MediaPipe research app (autism, dementia, rare neuro). Research only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite --host",
    "serve:ssl": "vite --host --https",
    "sync": "npx cap sync",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "copy": "npx cap copy",
    "update": "npx cap update",
    "run:web": "vite",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios",
    "build:prod": "vite build && npx cap sync",
    "deploy:vercel": "vercel --prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/app": "^5.0.6",
    "@capacitor/camera": "^5.0.7",
    "@capacitor/core": "^5.5.1",
    "@capacitor/filesystem": "^5.1.4",
    "@capacitor/geolocation": "^5.0.6",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/ios": "^5.5.1",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/share": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@clerk/clerk-react": "^5.61.3",
    "@supabase/supabase-js": "^2.99.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
